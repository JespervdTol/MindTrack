<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MindTrack.Pages.ScorePage"
             Title="">
    <ScrollView>
        <VerticalStackLayout Margin="20,0,20,20">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto" Margin="0,20,0,10">  
                <Label Text="Scoreboard/Personen" 
                       FontSize="25" 
                       FontAttributes="Bold" 
                       TextColor="Black" 
                       VerticalOptions="Center"/>

                <Picker Title="Selecteer spel" 
                        ItemsSource="{Binding GameList}" 
                        SelectedIndexChanged="OnGameSelected"
                        TextColor="Black"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="Center"
                        Margin="0,10,0,10"
                        IsVisible="{Binding IsScoreboardVisible}"/>

                <Button Text="Add Person" 
                        WidthRequest="150" 
                        HeightRequest="30"
                        Clicked="OnAddPersonClicked" 
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsPersonTableVisible}"
                        Margin="0,10,0,10" />

                <Image Source="mindtrack_logo.png" 
                       WidthRequest="150" 
                       HeightRequest="150"
                       Aspect="AspectFit"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Grid.Column="1" />
            </Grid>

            <HorizontalStackLayout Margin="0,10,0,10">
                <Button Text="Scoreboard" Clicked="ShowScoreboardTable" IsEnabled="{Binding IsPersonTableVisible}" />
                <Button Text="Personen" Clicked="ShowPersonTable" IsEnabled="{Binding IsScoreboardVisible}" />
            </HorizontalStackLayout>

            <Frame BackgroundColor="#F2F2F2" CornerRadius="10" Padding="10" Margin="0,10,0,0" IsVisible="{Binding IsScoreboardVisible}">
                <Grid RowDefinitions="Auto,*">

                    <Grid ColumnDefinitions="*,*,*,*,*" Padding="5">
                        <Label Text="ID" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="Naam" FontAttributes="Bold" FontSize="14" Grid.Column="1"/>
                        <Label Text="Score" FontAttributes="Bold" FontSize="14" Grid.Column="2"/>
                        <Label Text="Geboortedatum" FontAttributes="Bold" FontSize="14" Grid.Column="3"/>
                        <Label Text="Gespeelde Datum" FontAttributes="Bold" FontSize="14" Grid.Column="4"/>
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding PersonItems}" Margin="0,5,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,*,*,*" Padding="5" BackgroundColor="#E0E0E0" Margin="0,0,0,5">
                                    <Label Text="{Binding ID}" FontSize="14"/>
                                    <Label Text="{Binding Name}" FontSize="14" Grid.Column="1"/>
                                    <Label Text="{Binding Score}" FontSize="14" Grid.Column="2"/>
                                    <Label Text="{Binding Birthday, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" Grid.Column="3"/>
                                    <Label Text="{Binding DatePlayed, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="14" Grid.Column="4"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>

            <Frame BackgroundColor="#F2F2F2" CornerRadius="10" Padding="10" Margin="0,10,0,0" IsVisible="{Binding IsPersonTableVisible}">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,*" Padding="5">
                        <Label Text="Naam" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="Geboortedatum" FontAttributes="Bold" FontSize="14" Grid.Column="1"/>
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding PersonItems}" Margin="0,5,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*" Padding="5" BackgroundColor="#E0E0E0" Margin="0,0,0,5">
                                    <Label Text="{Binding Name}" FontSize="14"/>
                                    <Label Text="{Binding Birthday, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" Grid.Column="1"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>