<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MindTrack.Pages.AddPersonPage"
             Title="Add Person">

    <StackLayout Padding="20">
        <Entry x:Name="NameEntry" Placeholder="Enter name" />
        <Entry x:Name="EmailEntry" Placeholder="Enter email" Keyboard="Email" />
        <Entry x:Name="BirthdayEntry" Placeholder="Enter birthday (dd/MM/yyyy)" Keyboard="Text" />
    </StackLayout>
</ContentPage>